@model IEnumerable<Asp.NetHw7.Models.User>

@{
    ViewData["Title"] = "View";
}

<h1>View</h1>

<form action="/UsersRepository/SearchByName">
    <label name="Name">Поиск по имени: </label>
    <input type="text" name="name" value="" />
    <button type="submit">Поиск</button>
</form>
<form action="/UsersRepository/SearchByPosition">
    <label name="Position">Поиск по должности: </label>
    <input type="text" name="position" value="" />
    <button type="submit">Поиск</button>
</form>
<div>
    <a href="/UsersRepository/SortByAge">Сортировка по Возрасту</a> |
    <a href="/UsersRepository/SortBySalary">Сортировка по Зарплате</a>
</div>
<table class="table">
    <thead>
        <tr>
            User list
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Age)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Salary)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Position)
                </td>
            </tr>
    }
    </tbody>
</table>
