@model IEnumerable<Asp.NetHw7.Models.User>

@{
    ViewData["Title"] = "View";
}

<h1>Search user</h1>
<form id="searchForm" asp-controller="UsersRepository" asp-action="Index" method="get">
    <div>
        <label>Имя: </label>
        <input type="text" name="name" value="" />
    </div>

    <div>
        <label>Должность: </label>
        <input type="text" name="position" value="" />
    </div>

    <div>
        <span>Сортировка:</span>
        <label>
            <input type="checkbox" name="sortBy" value="Age" /> По Возрасту
        </label>
        <label>
            <input type="checkbox" name="sortBy" value="Salary" /> По Зарплате
        </label>
    </div>

    <button type="submit">Применить</button>
</form>
<br />

<div id="tableContainer">
    <partial name="_UsersTable" model="Model" />
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#searchForm').on('submit', function (e) {
                e.preventDefault();

                var form = $(this);
                var url = form.attr('action');
                var data = form.serialize();

                $.ajax({
                    type: 'GET',
                    url: url,
                    data: data,
                    success: function (result) {
                        $('#tableContainer').html(result);
                    }
                });
            });

            $('input[type=checkbox][name=sortBy]').change(function() {
            $('#searchForm').submit();
        });
        });
    </script>
}