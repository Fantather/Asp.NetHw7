@model IEnumerable<Asp.NetHw7.Models.User>

@{
    ViewData["Title"] = "View";
}

<h1>Search user</h1>
<form id="searchForm" asp-controller="UsersRepository" asp-action="Index" method="get">
    <div>
        <label>Имя: </label>
        <input type="text" name="name" value="" />
    </div>

    <div>
        <label>Должность: </label>
        <input type="text" name="position" value="" />
    </div>

    <div>
        <span>Сортировка:</span>
        <label>
            <input type="checkbox" name="sortBy" value="Age" /> По Возрасту
        </label>
        <label>
            <input type="checkbox" name="sortBy" value="Salary" /> По Зарплате
        </label>
    </div>

    <button type="submit">Применить</button>
</form>
<table class="table">
    <thead>
        <tr>
            <th colspan="5">User list</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Id)</td>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.Age)</td>
                <td>@Html.DisplayFor(modelItem => item.Salary)</td>
                <td>@Html.DisplayFor(modelItem => item.Position)</td>
            </tr>
        }
    </tbody>
</table>
